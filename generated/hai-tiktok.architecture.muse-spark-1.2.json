  "cards": [
    {
      "dot": "cyan",
      "title": "Hauptpfad",
      "items": [
        "Agenten-Session (Hermes/Codex) → queue.txt → Session Worker distill → Pipeline Coordinator tick",
        "Koordinator reserviert block-freie Revision und erstellt NotebookLM-Video über nlm CLI",
        "Fertiges Video wird auf 1080×1920 vertikal recodiert und als Post persistiert"
      ]
    },
    {
      "dot": "emerald",
      "title": "App",
      "items": [
        "Next.js 16 App Router: / (Feed) öffentlich, /upload + /ingest hinter Auth-Middleware",
        "API: POST /api/v1/posts (text/multipart) und POST /api/v1/ingest/notebooklm (splitNotebookContent)",
        "SQLite (Prisma + BetterSQLite3) + Filesystem-Media unter /api/media mit Range-Support"
      ]
    },
    {
      "dot": "violet",
      "title": "Qualität & Trust",
      "items": [
        "Script-Optimizer: Rubrik clarity/specificity/story/voice/ending, Blocker-Gate, beidseitiger Vergleich",
        "Sanitizer entfernt Secrets, E-Mails, URLs, private Pfade vor jedem Provider-Call",
        "Auth-Gate: HAI_API_KEY (Bearer) oder signierter hai_admin-Cookie — einheitlich in requireApiAuth"
      ]
    }
  ]
