  "cards": [
    {
      "dot": "cyan",
      "title": "Eintritt und Transport",
      "items": [
        "stdio ist Default; --transport bzw. HAI_TRANSPORT schaltet auf streamable-http",
        "Nicht-Loopback-Bind wird abgelehnt, solange HAI_HTTP_TOKEN fehlt",
        "Der Server ruft selbst nie ein Modell auf"
      ]
    },
    {
      "dot": "emerald",
      "title": "Contract-Kernel",
      "items": [
        "Genau eine aktive Mission; jeder Vertrag ist versioniert und gehasht",
        "Ein Session-Lease läuft ab und hängt an mission_id plus contract_hash",
        "check_activity liefert in_scope, drift, park_candidate, blocker oder unclear"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed",
      "items": [
        "Owner-Code geht nur an den Owner-Kanal, HAI_HOME speichert nur den Hash",
        "Pfade bleiben symlink-sicher unter der Projektwurzel, Evidenz wird per SHA-256 gebunden",
        "Audit-Events tragen seq und prev_hash und werden unter dem Missions-Lock geschrieben"
      ]
    }
  ]
