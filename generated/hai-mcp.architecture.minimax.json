  "cards": [
    {
      "dot": "cyan",
      "title": "One process, one writer",
      "items": [
        "MissionEngine is the canonical mutation authority",
        "fcntl flock serializes every state change under HAI_HOME",
        "Audit chain stores seq + prev_hash for tamper evidence"
      ]
    },
    {
      "dot": "amber",
      "title": "Owner is a separate principal",
      "items": [
        "Owner code is delivered off-band (file 0700 or ntfy push)",
        "HAI_HOME stores only the salted SHA-256 of the code",
        "Plaintext code never outlives delivery"
      ]
    },
    {
      "dot": "violet",
      "title": "Project paths are confined",
      "items": [
        "logical project_id resolves via per-device mount table",
        "Evidence checks require SHA-256 inside the project root",
        "Symlink-safe assert_under rejects escapes before any read"
      ]
    }
  ]
